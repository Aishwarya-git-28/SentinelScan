# SentinelScan Environment Configuration
# Copy this file to .env and set real values if needed.
# SentinelScan does not currently require any mandatory API keys.

# Optional: Override the User-Agent string
# SENTINELSCAN_USER_AGENT=SentinelScan/1.0.0 (custom)

# Optional: Override the request timeout in seconds
# SENTINELSCAN_TIMEOUT=15

# Optional: Override the TLS certificate expiry warning window (days)
# SENTINELSCAN_CERT_EXPIRY_DAYS=30
